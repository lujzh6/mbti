/* custom-tab-bar - 底部导航：毛玻璃 + 靛蓝主色 */

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: saturate(180%) blur(40rpx);
  -webkit-backdrop-filter: saturate(180%) blur(40rpx);
  display: flex;
  align-items: stretch;
  border-top: 1rpx solid rgba(231, 229, 228, 0.6);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 1000;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  padding-top: 10rpx;
}

/* 选中指示器 - 顶部小横条 */
.indicator {
  position: absolute;
  top: 0;
  width: 40rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #4F46E5;
}

/* 图标容器 */
.tab-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.svg-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
}

/* 标签文字 */
.tab-label {
  font-size: 20rpx;
  color: #A8A29E;
  font-weight: 400;
  line-height: 1;
}

.tab-item.active .tab-label {
  color: #4F46E5;
  font-weight: 600;
}

/* ========== 纯 CSS 图标 ========== */

/* 首页 - 小房子 */
.icon-home {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.house-roof {
  position: absolute;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 18rpx solid transparent;
  border-right: 18rpx solid transparent;
  border-bottom: 14rpx solid #A8A29E;
}

.icon-home.icon-active .house-roof {
  border-bottom-color: #4F46E5;
}

.house-body {
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 26rpx;
  height: 20rpx;
  border: 3rpx solid #A8A29E;
  border-radius: 2rpx;
  border-top: none;
}

.icon-home.icon-active .house-body {
  border-color: #4F46E5;
}

/* 测试 - 铅笔 */
.icon-test {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.pencil-body {
  position: absolute;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%) rotate(-45deg);
  width: 8rpx;
  height: 28rpx;
  background: #A8A29E;
  border-radius: 2rpx 2rpx 0 0;
}

.icon-test.icon-active .pencil-body {
  background: #4F46E5;
}

.pencil-tip {
  position: absolute;
  bottom: 6rpx;
  left: 50%;
  transform: translateX(-50%) rotate(-45deg);
  width: 0;
  height: 0;
  border-left: 4rpx solid transparent;
  border-right: 4rpx solid transparent;
  border-top: 8rpx solid #A8A29E;
}

.icon-test.icon-active .pencil-tip {
  border-top-color: #4F46E5;
}

/* 记录 - 日历 */
.icon-record {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.calendar-top {
  position: absolute;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 30rpx;
  height: 6rpx;
  background: #A8A29E;
  border-radius: 2rpx 2rpx 0 0;
}

.icon-record.icon-active .calendar-top {
  background: #4F46E5;
}

.calendar-body {
  position: absolute;
  top: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 30rpx;
  height: 26rpx;
  border: 3rpx solid #A8A29E;
  border-radius: 0 0 4rpx 4rpx;
  border-top: none;
}

.icon-record.icon-active .calendar-body {
  border-color: #4F46E5;
}

/* 我的 - 人物 */
.icon-profile {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.person-head {
  position: absolute;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #A8A29E;
}

.icon-profile.icon-active .person-head {
  background: #4F46E5;
}

.person-body {
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 14rpx;
  background: #A8A29E;
  border-radius: 14rpx 14rpx 0 0;
}

.icon-profile.icon-active .person-body {
  background: #4F46E5;
}
