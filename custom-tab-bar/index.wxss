/* custom-tab-bar - 底部导航：毛玻璃 + 四族群色 */

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: rgba(244, 243, 248, 0.92);
  backdrop-filter: saturate(180%) blur(40rpx);
  -webkit-backdrop-filter: saturate(180%) blur(40rpx);
  display: flex;
  align-items: stretch;
  border-top: 1rpx solid rgba(216, 213, 227, 0.6);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 1000;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  padding-top: 10rpx;
}

/* 选中指示器 - 每个 tab 用不同族群色 */
.indicator {
  position: absolute;
  top: 0;
  width: 40rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background: #7C3AED;
}

/* 首页 = 紫色, 测试 = 绿色, 记录 = 琥珀, 我的 = 蓝色 */
.tab-item:nth-child(1) .indicator { background: #7C3AED; }
.tab-item:nth-child(2) .indicator { background: #059669; }
.tab-item:nth-child(3) .indicator { background: #D97706; }
.tab-item:nth-child(4) .indicator { background: #2563EB; }

/* 图标容器 */
.tab-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.svg-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
}

/* 标签文字 */
.tab-label {
  font-size: 20rpx;
  color: #9E97B3;
  font-weight: 400;
  line-height: 1;
}

/* 每个 tab 选中时用自己的族群色 */
.tab-item:nth-child(1).active .tab-label { color: #7C3AED; font-weight: 600; }
.tab-item:nth-child(2).active .tab-label { color: #059669; font-weight: 600; }
.tab-item:nth-child(3).active .tab-label { color: #D97706; font-weight: 600; }
.tab-item:nth-child(4).active .tab-label { color: #2563EB; font-weight: 600; }

/* ========== CSS 图标 ========== */

/* 首页 - 小房子 (紫色系) */
.icon-home {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.house-roof {
  position: absolute;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 18rpx solid transparent;
  border-right: 18rpx solid transparent;
  border-bottom: 14rpx solid #9E97B3;
}

.icon-home.icon-active .house-roof {
  border-bottom-color: #7C3AED;
}

.house-body {
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 26rpx;
  height: 20rpx;
  border: 3rpx solid #9E97B3;
  border-radius: 2rpx;
  border-top: none;
}

.icon-home.icon-active .house-body {
  border-color: #7C3AED;
}

/* 测试 - 铅笔 (绿色系) */
.icon-test {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.pencil-body {
  position: absolute;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%) rotate(-45deg);
  width: 8rpx;
  height: 28rpx;
  background: #9E97B3;
  border-radius: 2rpx 2rpx 0 0;
}

.icon-test.icon-active .pencil-body {
  background: #059669;
}

.pencil-tip {
  position: absolute;
  bottom: 6rpx;
  left: 50%;
  transform: translateX(-50%) rotate(-45deg);
  width: 0;
  height: 0;
  border-left: 4rpx solid transparent;
  border-right: 4rpx solid transparent;
  border-top: 8rpx solid #9E97B3;
}

.icon-test.icon-active .pencil-tip {
  border-top-color: #059669;
}

/* 记录 - 日历 (琥珀色系) */
.icon-record {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.calendar-top {
  position: absolute;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 30rpx;
  height: 6rpx;
  background: #9E97B3;
  border-radius: 2rpx 2rpx 0 0;
}

.icon-record.icon-active .calendar-top {
  background: #D97706;
}

.calendar-body {
  position: absolute;
  top: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 30rpx;
  height: 26rpx;
  border: 3rpx solid #9E97B3;
  border-radius: 0 0 4rpx 4rpx;
  border-top: none;
}

.icon-record.icon-active .calendar-body {
  border-color: #D97706;
}

/* 我的 - 人物 (蓝色系) */
.icon-profile {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.person-head {
  position: absolute;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #9E97B3;
}

.icon-profile.icon-active .person-head {
  background: #2563EB;
}

.person-body {
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 14rpx;
  background: #9E97B3;
  border-radius: 14rpx 14rpx 0 0;
}

.icon-profile.icon-active .person-body {
  background: #2563EB;
}
