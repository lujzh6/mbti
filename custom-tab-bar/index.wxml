<!--custom-tab-bar/index.wxml-->
<view class="tab-bar">
  <view
    class="tab-bar-item {{selected === index ? 'selected' : ''}}"
    wx:for="{{list}}"
    wx:key="index"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="icon-wrapper">
      <text class="icon {{selected === index ? 'icon-selected' : ''}}" wx:if="{{index === 0}}">🏠</text>
      <text class="icon {{selected === index ? 'icon-selected' : ''}}" wx:elif="{{index === 1}}">📝</text>
      <text class="icon {{selected === index ? 'icon-selected' : ''}}" wx:elif="{{index === 2}}">📅</text>
      <text class="icon {{selected === index ? 'icon-selected' : ''}}" wx:elif="{{index === 3}}">👤</text>
    </view>
    <text class="text" style="color: {{selected === index ? selectedColor : color}}">{{item.text}}</text>
  </view>
</view>
