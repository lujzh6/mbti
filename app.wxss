/**
 * MBTI 人格探索 - 统一设计系统
 * 风格：温暖极简 - 干净卡片、柔和圆角、人格感配色
 * 色系：深墨（文字）+ 暖灰（背景）+ 靛蓝（主操作）+ 琥珀（辅助强调）
 */

/* ========== 设计令牌 ========== */
page {
  /* --- 核心色板 --- */
  --color-bg: #F7F6F3;              /* 暖灰米色背景 */
  --color-bg-card: #FFFFFF;          /* 纯白卡片 */
  --color-bg-elevated: #FAFAF8;     /* 微抬升背景（输入框等） */
  --color-text: #1C1917;            /* 深墨主文字 */
  --color-text-secondary: #78716C;  /* 石灰副文字 */
  --color-text-tertiary: #A8A29E;   /* 浅石灰辅助文字 */
  --color-border: #E7E5E4;          /* 温暖边框 */
  --color-separator: #F0EEEC;       /* 极淡分隔线 */

  /* --- 主操作色：靛蓝 --- */
  --color-primary: #4F46E5;         /* 靛蓝主色 */
  --color-primary-light: #EEF2FF;   /* 靛蓝浅底 */
  --color-primary-hover: #4338CA;   /* 靛蓝深色 */

  /* --- 辅助强调色 --- */
  --color-accent: #F59E0B;          /* 琥珀强调 */
  --color-accent-light: #FFFBEB;    /* 琥珀浅底 */
  --color-success: #10B981;         /* 翠绿成功 */
  --color-success-light: #ECFDF5;   /* 翠绿浅底 */

  /* --- 圆角 --- */
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 24rpx;
  --radius-full: 999rpx;

  /* --- 阴影 --- */
  --shadow-sm: 0 1rpx 3rpx rgba(28, 25, 23, 0.04);
  --shadow-md: 0 4rpx 12rpx rgba(28, 25, 23, 0.06);
  --shadow-lg: 0 8rpx 24rpx rgba(28, 25, 23, 0.08);

  /* --- 间距 --- */
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 24rpx;
  --space-xl: 32rpx;
  --space-2xl: 40rpx;
  --space-3xl: 48rpx;
  --space-page: 32rpx;

  /* --- 字体 --- */
  font-family: -apple-system, "SF Pro Text", "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  color: var(--color-text);
  background: var(--color-bg);
  line-height: 1.5;
}

/* ========== 通用组件 ========== */

/* 按钮 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 40rpx;
  border-radius: var(--radius-md);
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  line-height: 1;
  transition: opacity 0.15s ease;
}

.btn::after {
  border: none;
}

.btn:active {
  opacity: 0.8;
}

.btn.primary {
  background: var(--color-primary);
  color: #FFFFFF;
}

.btn.secondary {
  background: var(--color-bg-elevated);
  color: var(--color-text);
  border: 1rpx solid var(--color-border);
}

.btn.ghost {
  background: transparent;
  color: var(--color-primary);
}

.btn[disabled] {
  opacity: 0.4;
}

/* 卡片 */
.card-base {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-xl);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--color-border);
}
