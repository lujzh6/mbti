/**
 * MBTI 人格探索 - 全局设计系统
 * 风格：Shadcn UI - 极简、干净、圆角卡片设计
 * 主色调：深灰色 | 背景：浅灰色 | 按钮：低饱和度亮色
 */

/* ========== 设计令牌（Design Tokens）========== */
page {
  /* 颜色系统 - Shadcn UI 风格 */
  --color-bg: #f5f5f5;           /* 浅灰背景 */
  --color-bg-card: #ffffff;      /* 卡片背景 */
  --color-text: #1a1a1a;         /* 深灰主文字 */
  --color-text-secondary: #6b6b6b; /* 中灰副文字 */
  --color-text-tertiary: #9b9b9b; /* 浅灰辅助文字 */
  --color-border: #e5e5e5;       /* 边框颜色 */
  
  /* 强调色 - 低饱和度亮色 */
  --color-accent-primary: #e8eaf6;  /* 低饱和度浅蓝灰（按钮背景） */
  --color-accent-action: #5c6bc0;   /* 低饱和度蓝紫（行动点） */
  
  /* 圆角 */
  --radius-card: 16rpx;
  --radius-btn: 12rpx;
  --radius-tag: 8rpx;
  
  /* 阴影 */
  --shadow-card: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-soft: 0 1rpx 4rpx rgba(0, 0, 0, 0.06);
  
  /* 间距 */
  --space-page: 32rpx;
  --space-card: 28rpx;
  --space-gap: 24rpx;
  
  font-family: -apple-system-font, "PingFang SC", "Helvetica Neue", sans-serif;
}

/* ========== 全局容器 ========== */
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
}

/* ========== 通用组件（各页面可复用）========== */
.btn {
  border-radius: var(--radius-btn);
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  min-height: 88rpx;
  padding: 0 40rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.btn.primary {
  background: var(--color-accent-primary);
  color: var(--color-text);
}

.btn.secondary {
  background: var(--color-bg-card);
  color: var(--color-text);
  border: 1rpx solid var(--color-border);
}

.card-base {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  padding: var(--space-card);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--color-border);
}
