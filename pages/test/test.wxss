/* pages/test/test.wxss - MBTI 测试 */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--space-page);
  padding-bottom: 160rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: var(--space-xl);
}

/* ========== 进度 ========== */
.progress-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-count {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.progress-pct {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-primary);
}

.progress-track {
  height: 8rpx;
  background: var(--color-border);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--color-primary);
  border-radius: var(--radius-full);
  transition: width 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ========== 题目卡片 ========== */
.question-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 36rpx 32rpx;
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-md);
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

.question-badge {
  display: inline-block;
  align-self: flex-start;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-full);
  letter-spacing: 2rpx;
}

.question-body {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

/* 选项 */
.choice {
  display: flex;
  align-items: flex-start;
  gap: var(--space-md);
  padding: 28rpx 24rpx;
  border-radius: var(--radius-lg);
  border: 2rpx solid var(--color-border);
  background: var(--color-bg-elevated);
  transition: all 0.2s ease;
}

.choice:active {
  transform: scale(0.98);
}

.choice.chosen {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

.choice-marker {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-bg);
  border: 2rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.choice.chosen .choice-marker {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #FFFFFF;
}

.choice-text {
  font-size: 30rpx;
  line-height: 1.55;
  color: var(--color-text);
  flex: 1;
  padding-top: 6rpx;
}

/* 分隔 */
.divider-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 8rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: var(--color-separator);
}

.divider-or {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--color-text-tertiary);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

/* ========== 底部导航 ========== */
.nav-row {
  display: flex;
  gap: 16rpx;
}

.nav-btn {
  flex: 1;
}

.save-hint {
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}
