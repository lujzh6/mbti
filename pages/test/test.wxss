/* pages/test/test.wxss - MBTI 测试：族群色彩版 */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--space-page);
  padding-bottom: 160rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: var(--space-xl);
}

/* ========== 进度 ========== */
.progress-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-count {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.progress-dim {
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.progress-track {
  height: 10rpx;
  background: var(--color-border);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: var(--radius-full);
  transition: width 0.35s cubic-bezier(0.4, 0, 0.2, 1), background 0.3s ease;
}

/* 维度指示条 - 四族群色 */
.dim-indicator-row {
  display: flex;
  gap: 10rpx;
}

.dim-chip {
  flex: 1;
  text-align: center;
  padding: 8rpx 0;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: var(--radius-sm);
  background: var(--color-bg-card);
  color: var(--color-text-tertiary);
  border: 2rpx solid transparent;
  letter-spacing: 1rpx;
  transition: all 0.2s ease;
}

.dim-chip.active {
  font-weight: 700;
  transform: scale(1.02);
}

/* ========== 题目卡片 ========== */
.question-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 36rpx 28rpx;
  box-shadow: var(--shadow-md);
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

.question-body {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

/* 选项 */
.choice {
  display: flex;
  align-items: flex-start;
  gap: var(--space-md);
  padding: 28rpx 24rpx;
  border-radius: var(--radius-lg);
  border: 2rpx solid var(--color-border);
  background: var(--color-bg-card-inner);
  transition: all 0.2s ease;
}

.choice:active {
  transform: scale(0.98);
}

.choice.chosen {
  border-color: var(--chosen-color, var(--color-analysts));
  background: var(--chosen-bg, var(--color-analysts-light));
  box-shadow: 0 2rpx 12rpx rgba(124, 58, 237, 0.12);
}

.choice-marker {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-bg);
  border: 2rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--color-text-secondary);
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.choice-text {
  font-size: 30rpx;
  line-height: 1.55;
  color: var(--color-text);
  flex: 1;
  padding-top: 6rpx;
}

/* 分隔 */
.divider-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 8rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: var(--color-separator);
}

.divider-or {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--color-text-tertiary);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

/* ========== 底部导航 ========== */
.nav-row {
  display: flex;
  gap: 16rpx;
}

.nav-btn {
  flex: 1;
}

.save-hint {
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}
