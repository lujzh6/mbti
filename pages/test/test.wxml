<!--pages/test/test.wxml - MBTI 测试 -->
<view class="page">
  <view class="progress-bar">
    <view class="progress-inner" style="width: {{progress}}%"></view>
  </view>
  <view class="progress-text">{{progress}}% · 第 {{currentIndex + 1}} / {{questions.length}} 题</view>

  <view class="question-area" wx:if="{{questions.length > 0}}">
    <view class="question-header">
      <view class="question-icon animate-icon">{{questions[currentIndex].icon || '💭'}}</view>
      <view class="question-index">第 {{currentIndex + 1}} 题</view>
    </view>
    <view class="question-text">{{questions[currentIndex].textA}}</view>
    <view class="vs">—— 或 ——</view>
    <view class="question-text">{{questions[currentIndex].textB}}</view>

    <view class="options">
      <view
        class="option {{answers[questions[currentIndex].id] === 'A' ? 'selected' : ''}}"
        data-id="{{questions[currentIndex].id}}"
        data-choice="A"
        bindtap="choose"
      >更符合左边</view>
      <view
        class="option {{answers[questions[currentIndex].id] === 'B' ? 'selected' : ''}}"
        data-id="{{questions[currentIndex].id}}"
        data-choice="B"
        bindtap="choose"
      >更符合右边</view>
    </view>
  </view>

  <view class="nav-btns">
    <button class="btn secondary" disabled="{{currentIndex === 0}}" bindtap="prev">上一题</button>
    <button class="btn secondary" wx:if="{{currentIndex < questions.length - 1}}" bindtap="next">下一题</button>
    <button class="btn primary" wx:if="{{currentIndex >= questions.length - 1}}" bindtap="submitManual">提交并查看结果</button>
  </view>
  <view class="tip">进度会自动保存，下次可继续作答</view>
</view>
