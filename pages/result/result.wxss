/* pages/result/result.wxss - 测试结果 */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--space-page);
  padding-bottom: 200rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: var(--space-xl);
}

/* ========== 主卡片 ========== */
.result-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-md);
  overflow: hidden;
}

/* 类型头部 */
.result-header {
  display: flex;
  align-items: center;
  gap: var(--space-xl);
  padding: 40rpx 32rpx 32rpx;
  border-bottom: 1rpx solid var(--color-separator);
}

.type-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--color-bg-elevated);
}

.type-text {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.type-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.type-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
}

.type-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* 描述 */
.desc-section {
  padding: 28rpx 32rpx;
}

.desc-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
}

/* 通用段落 */
.section {
  padding: 0 32rpx 32rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--color-separator);
}

/* 雷达图 */
.radar-wrap {
  display: flex;
  justify-content: center;
  padding: 16rpx 0;
}

.radar-canvas {
  width: 360rpx;
  height: 360rpx;
}

.radar-legend {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.legend-label {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* 列表 */
.list-group {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.list-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.list-bullet {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 10rpx;
}

.list-bullet.success {
  background: var(--color-success);
}

.list-bullet.warn {
  background: var(--color-accent);
}

.list-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* 职业标签 */
.career-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.career-tag {
  padding: 10rpx 22rpx;
  border: 2rpx solid;
  border-radius: var(--radius-full);
  font-size: 24rpx;
  font-weight: 500;
  background: transparent;
}

/* ========== 操作按钮 ========== */
.action-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-btn {
  width: 100%;
}

.action-btn.primary {
  color: #FFFFFF !important;
}

.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 600px;
  height: 900px;
}
