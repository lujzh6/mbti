/* pages/result/result.wxss - 结果页：iOS 卡片 + 人格色 */
.page {
  min-height: 100vh;
  background: var(--color-bg, #F2F2F7);
  padding: var(--space-page, 32rpx);
  padding-bottom: 200rpx;
  box-sizing: border-box;
}

.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  margin-bottom: var(--space-gap);
}

.card .header {
  background: var(--mbti-color, var(--color-accent-violet));
  color: #fff;
  padding: 48rpx var(--space-card);
}

.card .type {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.card .name {
  font-size: 32rpx;
  opacity: 0.95;
  margin-top: 12rpx;
}

.desc {
  padding: var(--space-card);
  font-size: 28rpx;
  line-height: 1.65;
  color: var(--color-text-secondary);
}

.section {
  padding: 0 var(--space-card) var(--space-card);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16rpx;
  display: block;
}

.radar-wrap {
  position: relative;
  height: 320rpx;
  margin-top: 16rpx;
}

.radar-canvas {
  width: 320rpx;
  height: 320rpx;
  margin: 0 auto;
  display: block;
}

.radar-labels {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.list .item {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  background: var(--color-bg);
  color: var(--color-text-secondary);
  font-size: 24rpx;
  padding: 12rpx 20rpx;
  border-radius: var(--radius-tag);
}

.actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-gap);
}

.btn {
  border-radius: var(--radius-btn);
  font-size: 30rpx;
  font-weight: 500;
}

.btn.primary {
  background: var(--mbti-color, var(--color-accent-violet));
  color: #fff;
}

.btn.secondary {
  background: var(--color-bg-card);
  color: var(--color-text);
  border: 1rpx solid var(--color-separator);
}

.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 600px;
  height: 900px;
}
