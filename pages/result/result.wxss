/* pages/result/result.wxss - 测试结果 - 丰富族群色彩 */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--space-page);
  padding-bottom: 200rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: var(--space-xl);
}

/* ========== 主卡片 ========== */
.result-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-lg);
  overflow: hidden;
}

/* Hero 区域 */
.result-hero {
  padding: 44rpx 32rpx 36rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  position: relative;
  overflow: hidden;
}

.hero-deco {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
}

.hero-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.2;
}

.c1 { width: 140rpx; height: 140rpx; top: -30rpx; right: -20rpx; }
.c2 { width: 100rpx; height: 100rpx; bottom: -20rpx; left: 30rpx; }

.group-chip {
  align-self: flex-start;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-full);
}

.group-chip-text {
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.85);
  letter-spacing: 1rpx;
}

.type-big {
  font-size: 72rpx;
  font-weight: 900;
  color: #FFFFFF;
  letter-spacing: 6rpx;
  line-height: 1.1;
}

.type-names {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.type-cn {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.type-en {
  font-size: 24rpx;
  font-weight: 500;
  color: rgba(255,255,255,0.7);
}

/* 角色形象栏 */
.role-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--color-separator);
}

.role-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-lg);
  border: 3rpx solid;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.role-emoji {
  font-size: 40rpx;
}

.role-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.role-name {
  font-size: 28rpx;
  font-weight: 700;
}

.role-motto {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-style: italic;
  line-height: 1.4;
}

/* 描述 */
.desc-section {
  padding: 24rpx 28rpx;
}

.desc-body {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
}

/* 通用段落 */
.section {
  padding: 0 28rpx 28rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--color-separator);
}

/* 雷达图 */
.radar-wrap {
  display: flex;
  justify-content: center;
  padding: 16rpx 0;
}

.radar-canvas {
  width: 320rpx;
  height: 320rpx;
}

.radar-legend {
  display: flex;
  justify-content: center;
  gap: 28rpx;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
}

.legend-label {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  font-weight: 500;
}

/* 列表 */
.list-group {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.list-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.list-bullet {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 10rpx;
}

.list-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* 职业标签 */
.career-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.career-tag {
  padding: 10rpx 22rpx;
  border: 2rpx solid;
  border-radius: var(--radius-full);
  font-size: 24rpx;
  font-weight: 500;
}

/* ========== 操作按钮 ========== */
.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-btn {
  width: 100%;
}

.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 600px;
  height: 900px;
}
