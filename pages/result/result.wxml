<!--pages/result/result.wxml - 测试结果：丰富族群色彩-->
<view class="page" style="--type-color: {{color}}; --type-light: {{colorLight}}; --type-mid: {{colorMid}}; --group-color: {{groupColor}}; --group-light: {{groupLight}}">

  <!-- 主卡片 -->
  <view id="result-card" class="result-card">

    <!-- 彩色 Hero -->
    <view class="result-hero" style="background: linear-gradient(135deg, {{color}}, {{groupColor}})">
      <view class="hero-deco">
        <view class="hero-circle c1" style="background: {{colorMid}}"></view>
        <view class="hero-circle c2" style="background: {{groupLight}}"></view>
      </view>
      <!-- 族群标签 -->
      <view class="group-chip" style="background: rgba(255,255,255,0.2)">
        <text class="group-chip-text">{{groupName}}</text>
      </view>
      <!-- 类型大字 -->
      <text class="type-big">{{type}}</text>
      <view class="type-names">
        <text class="type-cn">{{name}}</text>
        <text class="type-en">{{nameEn}}</text>
      </view>
    </view>

    <!-- 角色形象 -->
    <view class="role-bar">
      <view class="role-avatar" style="background: {{colorLight}}; border-color: {{colorMid}}">
        <text class="role-emoji">{{emoji}}</text>
      </view>
      <view class="role-text">
        <text class="role-name" style="color: {{color}}">{{role}}</text>
        <text class="role-motto">"{{motto}}"</text>
      </view>
    </view>

    <!-- 描述 -->
    <view class="desc-section">
      <text class="desc-body">{{desc}}</text>
    </view>

    <!-- 雷达图 -->
    <view class="section">
      <text class="section-title">四维度概览</text>
      <view class="radar-wrap">
        <canvas class="radar-canvas" canvas-id="radarCanvas" id="radarCanvas"></canvas>
      </view>
      <view class="radar-legend">
        <view class="legend-item">
          <view class="legend-dot" style="background: #7C3AED"></view>
          <text class="legend-label">E/I</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot" style="background: #059669"></view>
          <text class="legend-label">S/N</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot" style="background: #D97706"></view>
          <text class="legend-label">T/F</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot" style="background: #2563EB"></view>
          <text class="legend-label">J/P</text>
        </view>
      </view>
    </view>

    <!-- 优势 -->
    <view class="section">
      <text class="section-title">核心优势</text>
      <view class="list-group">
        <view class="list-row" wx:for="{{strengths}}" wx:key="*this">
          <view class="list-bullet" style="background: {{color}}"></view>
          <text class="list-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 盲点 -->
    <view class="section">
      <text class="section-title">需要留意</text>
      <view class="list-group">
        <view class="list-row" wx:for="{{blindSpots}}" wx:key="*this">
          <view class="list-bullet" style="background: #F59E0B"></view>
          <text class="list-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 职业推荐 -->
    <view class="section">
      <text class="section-title">适合职业</text>
      <view class="career-tags">
        <view class="career-tag" wx:for="{{careers}}" wx:key="*this" style="border-color: {{colorMid}}; color: {{color}}; background: {{colorLight}}">
          {{item}}
        </view>
      </view>
    </view>

  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <button class="btn primary action-btn" style="background: {{color}} !important; color: #fff !important" bindtap="savePoster">保存分享图</button>
    <button class="btn secondary action-btn" bindtap="goCharts">查看演化图表</button>
    <button class="btn secondary action-btn" bindtap="goHome">返回首页</button>
  </view>

  <canvas class="hidden-canvas" canvas-id="posterCanvas" id="posterCanvas" style="width: 600px; height: 900px;"></canvas>
</view>
