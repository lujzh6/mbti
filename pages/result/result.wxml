<!--pages/result/result.wxml - 测试结果-->
<view class="page">
  <!-- 主卡片 -->
  <view id="result-card" class="result-card" style="--mbti-color: {{color}}">
    <!-- 类型头部 -->
    <view class="result-header">
      <view class="type-circle" style="border-color: {{color}}">
        <text class="type-text" style="color: {{color}}">{{type}}</text>
      </view>
      <view class="type-meta">
        <text class="type-name">{{name}}</text>
        <text class="type-label">你的 MBTI 人格类型</text>
      </view>
    </view>

    <!-- 描述 -->
    <view class="desc-section">
      <text class="desc-text">{{desc}}</text>
    </view>

    <!-- 雷达图 -->
    <view class="section">
      <text class="section-title">四维度概览</text>
      <view class="radar-wrap">
        <canvas class="radar-canvas" canvas-id="radarCanvas" id="radarCanvas"></canvas>
      </view>
      <view class="radar-legend">
        <view class="legend-item">
          <view class="legend-dot" style="background: {{color}}"></view>
          <text class="legend-label">E 外向</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot" style="background: {{color}}; opacity: 0.7"></view>
          <text class="legend-label">S 实感</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot" style="background: {{color}}; opacity: 0.5"></view>
          <text class="legend-label">T 思考</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot" style="background: {{color}}; opacity: 0.35"></view>
          <text class="legend-label">J 判断</text>
        </view>
      </view>
    </view>

    <!-- 优势 -->
    <view class="section">
      <text class="section-title">核心优势</text>
      <view class="list-group">
        <view class="list-row" wx:for="{{strengths}}" wx:key="*this">
          <view class="list-bullet success"></view>
          <text class="list-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 盲点 -->
    <view class="section">
      <text class="section-title">需要留意</text>
      <view class="list-group">
        <view class="list-row" wx:for="{{blindSpots}}" wx:key="*this">
          <view class="list-bullet warn"></view>
          <text class="list-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 职业推荐 -->
    <view class="section">
      <text class="section-title">适合职业</text>
      <view class="career-tags">
        <view class="career-tag" wx:for="{{careers}}" wx:key="*this" style="border-color: {{color}}; color: {{color}}">
          {{item}}
        </view>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-group">
    <button class="btn primary action-btn" style="background: {{color}}" bindtap="savePoster">保存分享图</button>
    <button class="btn secondary action-btn" bindtap="goCharts">查看演化图表</button>
    <button class="btn secondary action-btn" bindtap="goHome">返回首页</button>
  </view>

  <canvas class="hidden-canvas" canvas-id="posterCanvas" id="posterCanvas" style="width: 600px; height: 900px;"></canvas>
</view>
