/* pages/charts/charts.wxss - 演化图表 */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--space-page);
  padding-bottom: 160rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

/* 页面标题 */
.page-header {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

/* 卡片 */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

.card-header {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.card-subtitle {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* 洞察卡片 */
.insight-card {
  background: linear-gradient(135deg, #7C3AED, #5B21B6);
}

.range-row {
  display: flex;
  gap: 12rpx;
}

.range-chip {
  padding: 10rpx 28rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-full);
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.7);
}

.range-chip.active {
  background: rgba(255, 255, 255, 0.95);
  color: #7C3AED;
  font-weight: 600;
}

.range-chip:active {
  opacity: 0.85;
}

.insight-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.55;
}

/* 图例 */
.chart-legend {
  display: flex;
  gap: 24rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 3rpx;
}

.dot-ei { background: #7C3AED; }
.dot-sn { background: #059669; }
.dot-tf { background: #D97706; }
.dot-jp { background: #2563EB; }

.legend-text {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* 柱状图 */
.bar-chart {
  display: flex;
  gap: 12rpx;
  height: 240rpx;
}

.bar-y-axis {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: 40rpx;
  flex-shrink: 0;
}

.y-label {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  text-align: right;
}

.bar-area {
  flex: 1;
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  position: relative;
  border-bottom: 1rpx solid var(--color-separator);
}

.bar-grid-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 1rpx;
  background: var(--color-separator);
}

.bar-group {
  flex: 1;
  display: flex;
  align-items: flex-end;
  gap: 2rpx;
  height: 100%;
}

.bar {
  flex: 1;
  min-height: 4rpx;
  border-radius: 4rpx 4rpx 0 0;
  transition: height 0.3s ease;
}

.bar-ei { background: #7C3AED; }
.bar-sn { background: #059669; }
.bar-tf { background: #D97706; }
.bar-jp { background: #2563EB; }

/* 对比 */
.compare-row {
  display: flex;
  align-items: center;
}

.compare-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.compare-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.compare-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
}

.compare-divider {
  width: 1rpx;
  height: 64rpx;
  background: var(--color-separator);
}

/* 导出 */
.export-card {
  gap: var(--space-md);
}

.export-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.export-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.export-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.export-desc {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.export-badge {
  background: var(--color-accent-light);
  color: var(--color-accent);
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

.export-btn {
  width: 100%;
}
