/* pages/charts/charts.wxss - 演化图表：iOS 风格 */
.page {
  min-height: 100vh;
  background: var(--color-bg, #F2F2F7);
  padding: var(--space-page, 32rpx);
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  padding: var(--space-card);
  margin-bottom: var(--space-gap);
  box-shadow: var(--shadow-card);
}

.label {
  font-size: 28rpx;
  color: var(--color-text);
  margin-bottom: 12rpx;
  display: block;
  font-weight: 500;
}

.picker {
  padding: 20rpx;
  background: var(--color-bg);
  border-radius: var(--radius-btn);
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.insight {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
  margin-top: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16rpx;
  display: block;
}

.sub, .trend-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 20rpx;
  display: block;
}

.legend {
  display: flex;
  gap: 32rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 20rpx;
}

.trend-bars {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  height: 200rpx;
}

.bar-wrap {
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.bar {
  width: 100%;
  min-height: 8rpx;
  border-radius: 8rpx 8rpx 0 0;
}

.bar.ei {
  background: var(--color-accent-sky);
}

.tip {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-top: 24rpx;
}

.btn {
  margin-top: 16rpx;
  border-radius: var(--radius-btn);
  font-size: 28rpx;
  font-weight: 500;
}

.btn.secondary {
  background: var(--color-bg);
  color: var(--color-text);
}
