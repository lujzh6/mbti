<!--pages/profile/profile.wxml - 个人中心-->
<view class="page">
  <!-- 用户头部 -->
  <view class="profile-header">
    <image
      class="avatar"
      src="{{user.avatarUrl || 'https://mmbiz.qpic.cn/mmbiz/icTdbqWNOwNRna42FI242Lcia07jQodd2FJGIYQfG0LAJGFxM4FbnQP6yfMxBgJ0F3YRqJCJ1aPAK2dQagdusBZg/0'}}"
      mode="aspectFill"
    />
    <view class="profile-info">
      <text class="profile-name">{{user.nickName || '点击登录'}}</text>
      <text class="profile-date" wx:if="{{user.dateStr}}">加入于 {{user.dateStr}}</text>
    </view>
    <view class="update-link" bindtap="onLogin">更新</view>
  </view>

  <!-- MBTI 类型卡 -->
  <view class="type-card" wx:if="{{user.mbtiType}}">
    <view class="type-card-left">
      <text class="type-letter">{{user.mbtiType}}</text>
      <text class="type-cn-name">{{user.typeName}}</text>
    </view>
    <button class="btn secondary retest-btn" bindtap="goTest">重新测试</button>
  </view>
  <view class="type-card type-card-empty" wx:else>
    <text class="type-empty-text">完成测试后将显示你的人格类型</text>
    <button class="btn primary retest-btn" bindtap="goTest">去测试</button>
  </view>

  <!-- 测试历史 -->
  <view class="card">
    <text class="card-label">测试历史</text>
    <view class="history-list" wx:if="{{testHistory.length > 0}}">
      <view class="history-item" wx:for="{{testHistory}}" wx:key="id" bindtap="goResult" data-id="{{item.id}}">
        <view class="history-type-badge">{{item.type}}</view>
        <text class="history-name">{{item.typeName}}</text>
        <text class="history-date">{{item.dateStr}}</text>
        <text class="history-arrow">></text>
      </view>
    </view>
    <text class="empty-hint" wx:else>暂无测试记录</text>
  </view>

  <!-- 快捷入口 -->
  <view class="card">
    <view class="menu-row" bindtap="goRecords">
      <view class="menu-icon-wrap menu-icon-record">
        <view class="menu-icon-line m-l1"></view>
        <view class="menu-icon-line m-l2"></view>
      </view>
      <text class="menu-label">情境记录</text>
      <text class="menu-value">{{recordsCount}} 条</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-row" bindtap="goCharts">
      <view class="menu-icon-wrap menu-icon-chart">
        <view class="menu-icon-bar mb1"></view>
        <view class="menu-icon-bar mb2"></view>
        <view class="menu-icon-bar mb3"></view>
      </view>
      <text class="menu-label">演化图表</text>
      <text class="menu-value">查看</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <!-- 设置 -->
  <view class="card">
    <text class="card-label">设置</text>
    <view class="setting-row">
      <text class="setting-label">消息通知</text>
      <switch checked="{{notify}}" bindchange="toggleNotify" color="#4F46E5" />
    </view>
    <view class="setting-divider"></view>
    <view class="setting-row">
      <text class="setting-label">隐私保护</text>
      <switch checked="{{privacy}}" bindchange="togglePrivacy" color="#4F46E5" />
    </view>
  </view>

  <!-- 付费入口 -->
  <view class="card premium-card" bindtap="payEntry">
    <view class="premium-meta">
      <text class="premium-title">高级功能</text>
      <text class="premium-desc">PDF 报告导出、深度分析等</text>
    </view>
    <view class="premium-badge">即将推出</view>
  </view>
</view>
