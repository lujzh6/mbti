/* pages/profile/profile.wxss - 个人中心（丰富色彩版） */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--space-page);
  padding-bottom: 160rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

/* ========== 头部 ========== */
.profile-header {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 36rpx 32rpx;
  display: flex;
  align-items: center;
  gap: var(--space-lg);
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-md);
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--color-bg-elevated);
  flex-shrink: 0;
  border: 3rpx solid var(--color-border);
}

.profile-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-date {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.update-link {
  font-size: 26rpx;
  color: var(--color-analysts);
  font-weight: 500;
  flex-shrink: 0;
}

/* ========== MBTI 类型卡 ========== */
.type-card {
  border-radius: var(--radius-lg);
  padding: 24rpx 28rpx;
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.type-card-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.type-avatar-sm {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.type-emoji {
  font-size: 32rpx;
}

.type-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.type-letter {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.type-cn-name {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.retest-btn {
  min-height: 72rpx !important;
  padding: 0 28rpx !important;
  font-size: 26rpx !important;
}

.type-card-empty {
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  flex-direction: column;
  gap: 16rpx;
  align-items: stretch;
  text-align: center;
}

.type-empty-text {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
  text-align: center;
}

/* ========== 卡片 ========== */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx 28rpx;
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  letter-spacing: 1rpx;
}

/* 测试历史 */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-separator);
}

.history-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.history-type-badge {
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-sm);
  letter-spacing: 1rpx;
}

.history-name {
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
  flex: 1;
}

.history-date {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.history-arrow {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  font-weight: 300;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  text-align: center;
  padding: 16rpx 0;
}

/* ========== 快捷菜单 ========== */
.menu-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
}

.menu-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}

.menu-icon-line {
  position: absolute;
  left: 12rpx;
  height: 3rpx;
  border-radius: 2rpx;
}

.m-l1 { top: 18rpx; width: 24rpx; }
.m-l2 { top: 28rpx; width: 16rpx; opacity: 0.5; }

.menu-icon-bar {
  position: absolute;
  bottom: 12rpx;
  width: 6rpx;
  border-radius: 2rpx 2rpx 0 0;
}

.mb1 { left: 12rpx; height: 12rpx; opacity: 0.5; }
.mb2 { left: 22rpx; height: 20rpx; }
.mb3 { left: 32rpx; height: 14rpx; opacity: 0.7; }

.menu-label {
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
  flex: 1;
}

.menu-value {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

.menu-arrow {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  font-weight: 300;
}

.menu-divider {
  height: 1rpx;
  background: var(--color-separator);
  margin: 4rpx 0;
}

/* ========== 设置 ========== */
.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.setting-label {
  font-size: 28rpx;
  color: var(--color-text);
}

.setting-divider {
  height: 1rpx;
  background: var(--color-separator);
}

/* ========== 高级功能 ========== */
.premium-card {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: var(--color-bg-card);
}

.premium-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.premium-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.premium-desc {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.premium-badge {
  background: var(--color-explorers-light);
  color: var(--color-explorers);
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
}
