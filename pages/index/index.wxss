/* pages/index/index.wxss - 首页 TypeQuest 风格 */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--space-page);
  padding-bottom: 160rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

/* ========== Hero ========== */
.hero {
  background: linear-gradient(145deg, #5B21B6 0%, #7C3AED 40%, #A78BFA 100%);
  border-radius: var(--radius-xl);
  padding: 48rpx 36rpx 44rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  position: relative;
  overflow: hidden;
}

.hero-orbs {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
}

.orb {
  position: absolute;
  border-radius: 50%;
  opacity: 0.18;
}

.orb-purple { width: 160rpx; height: 160rpx; background: #C4B5FD; top: -40rpx; right: -20rpx; }
.orb-green { width: 100rpx; height: 100rpx; background: #6EE7B7; bottom: 20rpx; right: 60rpx; }
.orb-blue { width: 80rpx; height: 80rpx; background: #93C5FD; top: 40rpx; right: 120rpx; }
.orb-amber { width: 120rpx; height: 120rpx; background: #FCD34D; bottom: -30rpx; left: -20rpx; }

.hero-brand {
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.6);
  letter-spacing: 3rpx;
}

.hero-title-wrap {
  display: flex;
  flex-direction: column;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.25;
}

.hero-title-accent {
  color: #FCD34D;
}

.hero-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.65);
  line-height: 1.5;
  margin-top: 4rpx;
}

.hero-cta {
  margin-top: 16rpx;
  background: #FFFFFF !important;
  color: #5B21B6 !important;
  font-weight: 700;
  font-size: 30rpx;
  min-height: 88rpx;
  border-radius: var(--radius-lg);
  border: none;
  line-height: 88rpx;
}

.hero-cta::after { border: none; }
.hero-cta:active { opacity: 0.9; transform: scale(0.97); }

/* ========== 用户卡片 ========== */
.user-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 28rpx;
  box-shadow: var(--shadow-md);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.user-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-lg);
  background: var(--color-bg-elevated);
  flex-shrink: 0;
  border: 2rpx solid var(--color-border);
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.user-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-type-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.type-badge {
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  padding: 5rpx 16rpx;
  border-radius: var(--radius-sm);
  letter-spacing: 2rpx;
}

.type-role {
  font-size: 24rpx;
  font-weight: 600;
}

.user-motto {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
  font-style: italic;
  padding-top: 8rpx;
  border-top: 1rpx solid var(--color-separator);
}

.user-hint {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* 空卡片 */
.user-card-empty {
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.empty-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-lg);
  border: 3rpx dashed var(--color-border);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 14rpx;
  flex-shrink: 0;
}

.empty-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.btn-sm {
  flex-shrink: 0;
  min-height: 68rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  border-radius: var(--radius-lg);
  font-weight: 600;
  border: none;
  line-height: 68rpx;
}

.btn-sm::after { border: none; }

.btn-primary {
  background: var(--color-analysts) !important;
  color: #FFFFFF !important;
}

/* ========== Section Header ========== */
.section-head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-top: 8rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-text);
}

.section-sub {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* ========== 族群展示卡 ========== */
.group-showcase {
  border-radius: var(--radius-xl);
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.group-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.group-dots {
  display: flex;
  gap: 8rpx;
}

.gdot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
}

.group-label {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.group-slogan {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
}

.group-desc {
  font-size: 24rpx;
  line-height: 1.5;
  opacity: 0.85;
}

/* ========== Type Cards Grid (2x2) ========== */
.type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.type-card {
  width: calc(50% - 6rpx);
  background: rgba(255,255,255,0.85);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  transition: transform 0.15s ease;
}

.type-card:active {
  transform: scale(0.96);
}

/* 角色头像区 */
.type-avatar {
  width: 100%;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.type-card-meta {
  padding: 14rpx 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid rgba(0,0,0,0.05);
}

.type-card-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}

.type-card-code {
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

/* ========== CSS Monster Character ========== */
.monster {
  width: 120rpx;
  height: 140rpx;
  position: relative;
}

.monster-body {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 100rpx;
  height: 110rpx;
  border-radius: 50rpx 50rpx 30rpx 30rpx;
  opacity: 0.85;
}

/* 眼睛 */
.monster-eye {
  position: absolute;
  top: 40rpx;
  left: 28rpx;
  width: 20rpx;
  height: 22rpx;
  background: #FFFFFF;
  border-radius: 50%;
  z-index: 2;
}

.monster-eye::after {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 8rpx;
  width: 10rpx;
  height: 10rpx;
  background: #1A1625;
  border-radius: 50%;
}

.monster-eye-r {
  left: auto;
  right: 28rpx;
}

/* 嘴巴 */
.monster-mouth {
  position: absolute;
  top: 72rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 14rpx;
  border-radius: 0 0 14rpx 14rpx;
  background: #1A1625;
  opacity: 0.6;
  z-index: 2;
}

/* ===== 各角色特征 ===== */

/* 皇冠 - INTJ */
.monster-crown {
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 50rpx;
  height: 20rpx;
  z-index: 3;
}

.monster-crown::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 50rpx;
  height: 12rpx;
  background: var(--accent);
  border-radius: 2rpx;
}

.monster-crown::after {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-bottom: 10rpx solid var(--accent);
}

/* 眼镜 - INTP */
.monster-glasses {
  position: absolute;
  top: 38rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 24rpx;
  z-index: 3;
}

.monster-glasses::before {
  content: '';
  position: absolute;
  left: 0;
  top: 2rpx;
  width: 30rpx;
  height: 20rpx;
  border: 3rpx solid var(--accent);
  border-radius: 50%;
}

.monster-glasses::after {
  content: '';
  position: absolute;
  right: 0;
  top: 2rpx;
  width: 30rpx;
  height: 20rpx;
  border: 3rpx solid var(--accent);
  border-radius: 50%;
}

/* 犄角 - ENTJ */
.monster-horns {
  position: absolute;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 30rpx;
  z-index: 3;
}

.monster-horns::before {
  content: '';
  position: absolute;
  left: 4rpx;
  bottom: 0;
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-bottom: 24rpx solid var(--accent);
}

.monster-horns::after {
  content: '';
  position: absolute;
  right: 4rpx;
  bottom: 0;
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-bottom: 24rpx solid var(--accent);
}

/* 闪电 - ENTP */
.monster-lightning {
  position: absolute;
  top: 6rpx;
  right: 8rpx;
  width: 24rpx;
  height: 32rpx;
  z-index: 3;
  background: var(--accent);
  clip-path: polygon(50% 0%, 80% 40%, 55% 40%, 100% 100%, 20% 55%, 45% 55%, 0% 0%);
}

/* 爱心 - INFJ */
.monster-heart {
  position: absolute;
  top: 54rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 30rpx;
  height: 28rpx;
  z-index: 3;
}

.monster-heart::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 30rpx;
  height: 28rpx;
  background: #FFFFFF;
  clip-path: polygon(50% 100%, 0% 35%, 5% 10%, 25% 0%, 50% 20%, 75% 0%, 95% 10%, 100% 35%);
}

/* 花朵 - INFP */
.monster-flower {
  position: absolute;
  top: 4rpx;
  right: 12rpx;
  width: 28rpx;
  height: 28rpx;
  background: rgba(255,255,255,0.9);
  border-radius: 50%;
  z-index: 3;
}

.monster-flower::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%,-50%);
  width: 12rpx;
  height: 12rpx;
  background: var(--accent);
  border-radius: 50%;
}

/* 星星 - ENFJ */
.monster-star {
  position: absolute;
  top: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 28rpx;
  background: var(--accent);
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  z-index: 3;
}

/* 彩虹 - ENFP */
.monster-rainbow {
  position: absolute;
  top: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 30rpx;
  border: 6rpx solid var(--accent);
  border-bottom: none;
  border-radius: 40rpx 40rpx 0 0;
  z-index: 3;
  opacity: 0.7;
}

/* 盾牌 - ISTJ */
.monster-shield {
  position: absolute;
  top: 50rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 26rpx;
  height: 30rpx;
  background: rgba(255,255,255,0.9);
  clip-path: polygon(50% 100%, 0% 25%, 0% 0%, 100% 0%, 100% 25%);
  z-index: 3;
}

/* 伞 - ISFJ */
.monster-umbrella {
  position: absolute;
  top: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 50rpx;
  height: 20rpx;
  background: var(--accent);
  border-radius: 30rpx 30rpx 0 0;
  z-index: 3;
  opacity: 0.7;
}

.monster-umbrella::after {
  content: '';
  position: absolute;
  bottom: -14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 4rpx;
  height: 14rpx;
  background: var(--accent);
}

/* 徽章 - ESTJ */
.monster-badge {
  position: absolute;
  top: 52rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 24rpx;
  background: rgba(255,255,255,0.9);
  border: 3rpx solid var(--accent);
  border-radius: 50%;
  z-index: 3;
}

/* 握手 - ESFJ */
.monster-hands {
  position: absolute;
  bottom: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 12rpx;
  z-index: 3;
}

.monster-hands::before {
  content: '';
  position: absolute;
  left: 0;
  width: 28rpx;
  height: 12rpx;
  background: rgba(255,255,255,0.7);
  border-radius: 6rpx 0 0 6rpx;
}

.monster-hands::after {
  content: '';
  position: absolute;
  right: 0;
  width: 28rpx;
  height: 12rpx;
  background: rgba(255,255,255,0.5);
  border-radius: 0 6rpx 6rpx 0;
}

/* 扳手 - ISTP */
.monster-wrench {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 8rpx;
  height: 36rpx;
  background: var(--accent);
  border-radius: 4rpx;
  transform: rotate(-30deg);
  z-index: 3;
  opacity: 0.8;
}

.monster-wrench::after {
  content: '';
  position: absolute;
  top: -6rpx;
  left: -6rpx;
  width: 20rpx;
  height: 14rpx;
  border: 3rpx solid var(--accent);
  border-radius: 8rpx 8rpx 0 0;
  background: transparent;
}

/* 调色板 - ISFP */
.monster-palette {
  position: absolute;
  top: 6rpx;
  right: 8rpx;
  width: 30rpx;
  height: 24rpx;
  background: rgba(255,255,255,0.8);
  border-radius: 15rpx 15rpx 8rpx 8rpx;
  z-index: 3;
}

.monster-palette::before {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 8rpx;
  height: 8rpx;
  background: var(--accent);
  border-radius: 50%;
}

.monster-palette::after {
  content: '';
  position: absolute;
  top: 8rpx;
  right: 6rpx;
  width: 6rpx;
  height: 6rpx;
  background: #EF4444;
  border-radius: 50%;
}

/* 火焰 - ESTP */
.monster-fire {
  position: absolute;
  top: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 32rpx;
  z-index: 3;
}

.monster-fire::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 28rpx;
  background: var(--accent);
  border-radius: 50% 50% 20% 20%;
  clip-path: ellipse(50% 50% at 50% 60%);
}

.monster-fire::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 10rpx;
  height: 16rpx;
  background: #FCD34D;
  border-radius: 50% 50% 20% 20%;
}

/* 闪光 - ESFP */
.monster-sparkle {
  position: absolute;
  top: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 28rpx;
  z-index: 3;
}

.monster-sparkle::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%,-50%);
  width: 4rpx;
  height: 28rpx;
  background: var(--accent);
  border-radius: 2rpx;
}

.monster-sparkle::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%,-50%) rotate(90deg);
  width: 4rpx;
  height: 28rpx;
  background: var(--accent);
  border-radius: 2rpx;
}

/* ========== 快捷工具 ========== */
.tools-grid {
  display: flex;
  gap: 12rpx;
}

.tool-item {
  flex: 1;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  box-shadow: var(--shadow-sm);
  transition: transform 0.15s ease;
}

.tool-item:active {
  transform: scale(0.96);
}

.tool-icon-box {
  width: 60rpx;
  height: 60rpx;
  border-radius: var(--radius-md);
  background: var(--tool-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tool-icon-shape {
  background: var(--tool-color);
}

.tool-report {
  width: 24rpx;
  height: 24rpx;
  border-radius: 4rpx;
}

.tool-record {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.tool-chart {
  width: 24rpx;
  height: 16rpx;
  border-radius: 3rpx;
}

.tool-profile {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.tool-name {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}
