/* Shadcn UI 风格：极简、干净、圆角卡片设计 */
/* 主色调：深灰色 | 背景：浅灰色 | 按钮：低饱和度亮色 */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
  padding-bottom: 140rpx;
  background: #f5f5f5; /* 浅灰背景 */
  color: #1a1a1a;      /* 深灰文字 */
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 通用卡片样式 - Shadcn card 风格 */
.section-card,
.hero-card,
.feature-card {
  background: #ffffff;
  border-radius: 16rpx;
  border: 1rpx solid #e5e5e5;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* Hero / Slogan 卡片 - 突出显示 */
.hero-card {
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e5e5e5;
}

.hero-title {
  font-size: 44rpx;
  line-height: 1.3;
  font-weight: 600;
  color: #1a1a1a; /* 深灰主色 */
  letter-spacing: -0.5rpx;
}

.hero-subtitle {
  font-size: 28rpx;
  line-height: 1.5;
  color: #6b6b6b; /* 中灰副文字 */
  font-weight: 400;
}

.hero-actions {
  margin-top: 8rpx;
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

/* Shadcn 风格按钮 */
.btn {
  min-height: 88rpx;
  padding: 0 40rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: none;
  transition: opacity 0.2s;
}

/* 主按钮：低饱和度亮色（浅蓝灰），深灰文字 */
.btn-primary {
  background: #e8eaf6; /* 低饱和度浅蓝灰 */
  color: #1a1a1a; /* 深灰文字 */
}

.btn-primary:active {
  opacity: 0.8;
  background: #d5d8e8;
}

/* 用户信息卡片 */
.user-card {
  padding: 28rpx 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f0f0f0;
  border: 2rpx solid #e5e5e5;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.mbti-line {
  font-size: 26rpx;
  color: #6b6b6b;
  line-height: 1.4;
}

/* 功能卡片列表 */
.section-card-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 单个功能卡片 */
.feature-card {
  padding: 28rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  transition: transform 0.2s, box-shadow 0.2s;
}

.feature-card:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.06);
}

.feature-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.feature-desc {
  font-size: 26rpx;
  color: #6b6b6b;
  line-height: 1.5;
}

.feature-action {
  margin-top: 4rpx;
  font-size: 26rpx;
  color: #5c6bc0; /* 低饱和度蓝紫色，亮但不刺眼 */
  font-weight: 500;
}