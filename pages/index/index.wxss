/* pages/index/index.wxss - 首页 */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--space-page);
  padding-bottom: 160rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

/* ========== Hero ========== */
.hero {
  background: var(--color-primary);
  border-radius: var(--radius-xl);
  padding: 48rpx 36rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.hero-badge {
  display: inline-block;
  align-self: flex-start;
  background: rgba(255, 255, 255, 0.18);
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  font-weight: 500;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-full);
  letter-spacing: 1rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.35;
  letter-spacing: 0.5rpx;
}

.hero-highlight {
  color: #FDE68A;
}

.hero-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.5;
}

.hero-btn {
  margin-top: 12rpx;
  background: #FFFFFF !important;
  color: var(--color-primary) !important;
  font-weight: 600;
  border-radius: var(--radius-md);
}

.hero-btn:active {
  opacity: 0.9;
}

/* ========== 用户卡片 ========== */
.user-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  gap: var(--space-lg);
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-sm);
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--color-bg-elevated);
  flex-shrink: 0;
  border: 2rpx solid var(--color-border);
}

.login-placeholder {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  flex-shrink: 0;
  border: 2rpx dashed var(--color-primary);
  opacity: 0.6;
}

.user-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-type-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.type-badge {
  display: inline-block;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
  letter-spacing: 2rpx;
}

.user-desc {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.login-btn {
  flex-shrink: 0;
  min-height: 72rpx !important;
  padding: 0 28rpx !important;
  font-size: 26rpx !important;
  border-radius: var(--radius-md) !important;
}

/* ========== 功能导航 ========== */
.section-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  letter-spacing: 1rpx;
  text-transform: uppercase;
  padding-left: 4rpx;
}

.feature-grid {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.feature-item {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 28rpx 28rpx;
  display: flex;
  align-items: center;
  gap: var(--space-lg);
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-sm);
  transition: transform 0.15s ease;
}

.feature-item:active {
  transform: scale(0.98);
}

/* 功能图标 */
.feature-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}

.icon-result {
  background: var(--color-primary-light);
}

.icon-daily {
  background: var(--color-success-light);
}

.icon-trend {
  background: var(--color-accent-light);
}

.icon-user {
  background: #FDF2F8;
}

/* 图标 - 柱状图 */
.icon-chart-bar {
  position: absolute;
  bottom: 20rpx;
  width: 10rpx;
  border-radius: 3rpx 3rpx 0 0;
  background: var(--color-primary);
}

.bar-1 {
  left: 18rpx;
  height: 20rpx;
  opacity: 0.5;
}

.bar-2 {
  left: 34rpx;
  height: 32rpx;
}

.bar-3 {
  left: 50rpx;
  height: 24rpx;
  opacity: 0.7;
}

/* 图标 - 笔记线条 */
.icon-edit-line {
  position: absolute;
  left: 20rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--color-success);
}

.line-1 {
  top: 22rpx;
  width: 40rpx;
}

.line-2 {
  top: 34rpx;
  width: 32rpx;
  opacity: 0.6;
}

.line-3 {
  top: 46rpx;
  width: 24rpx;
  opacity: 0.35;
}

/* 图标 - 趋势线 */
.icon-trend-line {
  width: 36rpx;
  height: 4rpx;
  background: var(--color-accent);
  border-radius: 2rpx;
  transform: rotate(-15deg);
  position: relative;
}

.icon-trend-line::after {
  content: '';
  position: absolute;
  right: -2rpx;
  top: -6rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-accent);
}

/* 图标 - 人物 */
.icon-person-head-sm {
  position: absolute;
  top: 22rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #EC4899;
}

.icon-person-body-sm {
  position: absolute;
  top: 40rpx;
  width: 24rpx;
  height: 12rpx;
  border-radius: 12rpx 12rpx 0 0;
  background: #EC4899;
  opacity: 0.6;
}

/* 功能文字 */
.feature-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.feature-desc {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.feature-arrow {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
  font-weight: 300;
}
