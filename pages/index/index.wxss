/* pages/index/index.wxss - 首页：四族群色彩 */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--space-page);
  padding-bottom: 160rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

/* ========== Hero ========== */
.hero {
  background: linear-gradient(135deg, #7C3AED 0%, #5B21B6 50%, #4C1D95 100%);
  border-radius: var(--radius-xl);
  padding: 48rpx 36rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  position: relative;
  overflow: hidden;
}

/* 装饰圆点 */
.hero-bg-dots {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.dot {
  position: absolute;
  border-radius: 50%;
  opacity: 0.15;
}

.dot-1 {
  width: 120rpx;
  height: 120rpx;
  background: #059669;
  top: -30rpx;
  right: 40rpx;
}

.dot-2 {
  width: 80rpx;
  height: 80rpx;
  background: #D97706;
  bottom: 20rpx;
  right: 80rpx;
}

.dot-3 {
  width: 60rpx;
  height: 60rpx;
  background: #2563EB;
  top: 60rpx;
  right: -10rpx;
}

.dot-4 {
  width: 100rpx;
  height: 100rpx;
  background: #FBBF24;
  bottom: -20rpx;
  left: -20rpx;
}

.hero-brand {
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.3;
}

.hero-accent {
  color: #FCD34D;
}

.hero-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.65);
  line-height: 1.5;
}

.hero-btn {
  margin-top: 12rpx;
  background: #FFFFFF !important;
  color: #5B21B6 !important;
  font-weight: 700;
  border-radius: var(--radius-lg);
  min-height: 88rpx;
  font-size: 30rpx;
}

.hero-btn:active {
  opacity: 0.9;
}

/* ========== 用户卡片 ========== */
.user-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 28rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-shadow: var(--shadow-md);
}

.user-card-top {
  display: flex;
  align-items: center;
  gap: var(--space-lg);
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-lg);
  background: var(--color-bg-elevated);
  flex-shrink: 0;
  border: 2rpx solid var(--color-border);
}

.user-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.user-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-type-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.type-badge {
  display: inline-block;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 800;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  letter-spacing: 2rpx;
}

.user-role {
  font-size: 26rpx;
  font-weight: 600;
}

.user-motto {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
  font-style: italic;
  padding-top: 4rpx;
  border-top: 1rpx solid var(--color-separator);
}

.user-hint {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* 空卡片 */
.user-card-empty {
  flex-direction: row;
  align-items: center;
  gap: var(--space-lg);
}

.empty-avatar-ring {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-lg);
  border: 3rpx dashed var(--color-border);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 12rpx;
  flex-shrink: 0;
}

.empty-avatar-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.btn-login {
  flex-shrink: 0;
  min-height: 68rpx !important;
  padding: 0 28rpx !important;
  font-size: 26rpx !important;
  background: var(--color-analysts) !important;
  color: #FFFFFF !important;
  border-radius: var(--radius-lg) !important;
  font-weight: 600;
}

/* ========== Section Header ========== */
.section-header {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding-top: 8rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text);
}

.section-desc {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* ========== 四族群网格 ========== */
.groups-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.group-card {
  width: calc(50% - 8rpx);
  border-radius: var(--radius-xl);
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  box-sizing: border-box;
  transition: transform 0.15s ease;
}

.group-card:active {
  transform: scale(0.97);
}

.group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.group-dot-row {
  display: flex;
  gap: 6rpx;
}

.group-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.group-name {
  font-size: 30rpx;
  font-weight: 800;
}

.group-subtitle {
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  opacity: 0.8;
}

.group-types {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 4rpx;
}

.group-type-chip {
  font-size: 20rpx;
  font-weight: 700;
  padding: 5rpx 12rpx;
  border-radius: var(--radius-sm);
  letter-spacing: 1rpx;
}

/* ========== 工具入口 ========== */
.tools-row {
  display: flex;
  gap: 12rpx;
}

.tool-card {
  flex: 1;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-shadow: var(--shadow-sm);
  transition: transform 0.15s ease;
}

.tool-card:active {
  transform: scale(0.96);
}

.tool-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tool-icon-inner {
  /* dimensions set inline */
}

.tool-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}
