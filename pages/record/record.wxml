<!--pages/record/record.wxml - 情境记录-->
<view class="page">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">情境记录</text>
    <text class="page-subtitle">记录今日场景、心情与行为倾向</text>
  </view>

  <!-- 场景 + 心情 -->
  <view class="card">
    <view class="field">
      <text class="field-label">今日场景</text>
      <view class="scene-list">
        <view
          class="scene-chip {{sceneIndex === idx ? 'active' : ''}}"
          wx:for="{{scenes}}"
          wx:for-index="idx"
          wx:key="id"
          data-index="{{idx}}"
          bindtap="onSceneTap"
        >{{item.name}}</view>
      </view>
    </view>
    <view class="field">
      <view class="field-label-row">
        <text class="field-label">心情评分</text>
        <view class="mood-value">{{mood}}<text class="mood-unit">/10</text></view>
      </view>
      <slider
        min="1"
        max="10"
        value="{{mood}}"
        step="1"
        activeColor="#7C3AED"
        backgroundColor="#D8D5E3"
        block-size="20"
        bindchange="onMoodChange"
      />
      <view class="mood-labels">
        <text class="mood-low">低落</text>
        <text class="mood-high">愉悦</text>
      </view>
    </view>
  </view>

  <!-- 行为标签 -->
  <view class="card">
    <text class="card-label">行为记录<text class="card-hint">（可多选）</text></text>
    <view class="tag-section" wx:for="{{tagGroups}}" wx:key="key">
      <text class="tag-group-title">{{item.title}}</text>
      <view class="tag-row">
        <view
          class="tag-chip {{selectedTags.indexOf(tag.id) > -1 ? 'active' : ''}}"
          wx:for="{{item.tags}}"
          wx:for-item="tag"
          wx:key="id"
          data-id="{{tag.id}}"
          bindtap="toggleTag"
        >{{tag.name}}</view>
      </view>
    </view>
  </view>

  <!-- 反思 -->
  <view class="card">
    <text class="card-label">简短反思<text class="card-hint">（可选）</text></text>
    <textarea
      class="reflect-input"
      placeholder="今天有什么想记下的？"
      value="{{reflect}}"
      bindinput="onReflectInput"
      maxlength="200"
    />
    <text class="char-count">{{reflect.length || 0}}/200</text>
  </view>

  <!-- 操作 -->
  <view class="action-row">
    <button class="btn primary action-btn" bindtap="submit">保存记录</button>
    <button class="btn secondary action-btn" bindtap="goRecords">查看历史</button>
  </view>
</view>
