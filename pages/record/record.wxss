/* pages/record/record.wxss - 情境记录：iOS 风格 */
.page {
  min-height: 100vh;
  background: var(--color-bg, #F2F2F7);
  padding: var(--space-page, 32rpx);
  padding-bottom: 180rpx;
  box-sizing: border-box;
}

.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  padding: var(--space-card);
  margin-bottom: var(--space-gap);
  box-shadow: var(--shadow-card);
}

.section {
  margin-bottom: 28rpx;
}

.section:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  color: var(--color-text);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.picker {
  padding: 24rpx;
  background: var(--color-bg);
  border-radius: var(--radius-btn);
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 24rpx;
  display: block;
}

.tag-group {
  margin-bottom: 28rpx;
}

.group-title {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
  display: block;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 16rpx 24rpx;
  background: var(--color-bg);
  border-radius: var(--radius-tag);
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.tag.selected {
  background: rgba(90, 200, 250, 0.15);
  color: #0A84FF;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  background: var(--color-bg);
  border-radius: var(--radius-btn);
  font-size: 28rpx;
  box-sizing: border-box;
  color: var(--color-text);
}

.actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-gap);
  margin-top: 32rpx;
}

.btn {
  border-radius: var(--radius-btn);
  font-size: 30rpx;
  font-weight: 500;
}

.btn.primary {
  background: var(--color-accent-green);
  color: #fff;
}

.btn.secondary {
  background: var(--color-bg-card);
  color: var(--color-text);
  border: 1rpx solid var(--color-separator);
}
