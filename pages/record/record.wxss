/* pages/record/record.wxss - 情境记录 (族群色彩版) */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--space-page);
  padding-bottom: 180rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

/* 页面标题 - 带彩色装饰 */
.page-header {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-bottom: 8rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-text);
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

/* 卡片 */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 28rpx 28rpx;
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

.card-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.card-hint {
  font-weight: 400;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-left: 8rpx;
}

/* 字段 */
.field {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.field-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
}

.field-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 场景选择 - 胶囊列表 */
.scene-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.scene-chip {
  padding: 14rpx 28rpx;
  background: var(--color-bg-elevated);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-full);
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  transition: all 0.15s ease;
}

.scene-chip.active {
  background: var(--color-analysts-light);
  border-color: var(--color-analysts);
  color: var(--color-analysts);
  font-weight: 600;
}

.scene-chip:active {
  transform: scale(0.96);
}

/* 心情 */
.mood-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-analysts);
}

.mood-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--color-text-tertiary);
}

.mood-labels {
  display: flex;
  justify-content: space-between;
  margin-top: -6rpx;
}

.mood-low,
.mood-high {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

/* 行为标签 - 每组用对应族群色 */
.tag-section {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.tag-group-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* 能量来源 EI = 紫色 */
.tag-section:nth-child(1) .tag-group-title::before {
  content: '';
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-analysts);
}

/* 信息处理 SN = 绿色 */
.tag-section:nth-child(2) .tag-group-title::before {
  content: '';
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-diplomats);
}

/* 决策方式 TF = 琥珀 */
.tag-section:nth-child(3) .tag-group-title::before {
  content: '';
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-explorers);
}

/* 生活态度 JP = 蓝色 */
.tag-section:nth-child(4) .tag-group-title::before {
  content: '';
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-sentinels);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-chip {
  padding: 12rpx 24rpx;
  background: var(--color-bg-elevated);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: 26rpx;
  color: var(--color-text-secondary);
  transition: all 0.15s ease;
}

/* 各组标签选中态使用对应族群色 */
.tag-section:nth-child(1) .tag-chip.active {
  background: var(--color-analysts-light);
  border-color: var(--color-analysts);
  color: var(--color-analysts);
  font-weight: 500;
}

.tag-section:nth-child(2) .tag-chip.active {
  background: var(--color-diplomats-light);
  border-color: var(--color-diplomats);
  color: var(--color-diplomats);
  font-weight: 500;
}

.tag-section:nth-child(3) .tag-chip.active {
  background: var(--color-explorers-light);
  border-color: var(--color-explorers);
  color: var(--color-explorers);
  font-weight: 500;
}

.tag-section:nth-child(4) .tag-chip.active {
  background: var(--color-sentinels-light);
  border-color: var(--color-sentinels);
  color: var(--color-sentinels);
  font-weight: 500;
}

.tag-chip:active {
  transform: scale(0.96);
}

/* 反思输入 */
.reflect-input {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  background: var(--color-bg-elevated);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  font-size: 28rpx;
  color: var(--color-text);
  box-sizing: border-box;
  line-height: 1.55;
}

.reflect-input:focus {
  border-color: var(--color-analysts-mid);
}

.char-count {
  text-align: right;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  margin-top: -8rpx;
}

/* 操作 */
.action-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-btn {
  width: 100%;
}
