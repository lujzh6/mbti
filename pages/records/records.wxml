<!--pages/records/records.wxml - 情境记录列表-->
<view class="page">
  <!-- 标题 -->
  <view class="page-header">
    <text class="page-title">情境记录</text>
    <text class="page-subtitle">每日场景与心情，关联维度分析</text>
  </view>

  <!-- 操作 -->
  <view class="actions">
    <button class="btn primary action-btn" bindtap="goRecord">今日打卡</button>
    <button class="btn secondary action-btn" bindtap="goCharts">演化图表</button>
  </view>

  <!-- 记录列表 -->
  <view class="list" wx:if="{{list.length > 0}}">
    <view class="record-item" wx:for="{{list}}" wx:key="id">
      <view class="record-top">
        <view class="record-date-row">
          <text class="record-date">{{item.dateStr || item.id}}</text>
          <view class="scene-badge">{{item.sceneName}}</view>
        </view>
        <view class="record-mood-row">
          <text class="mood-label">心情</text>
          <view class="mood-bar-track">
            <view class="mood-bar-fill" style="width: {{item.mood * 10}}%"></view>
          </view>
          <text class="mood-score">{{item.mood}}</text>
        </view>
      </view>
      <view class="record-tags" wx:if="{{item.tags && item.tags.length}}">
        <text class="tag-count">{{item.tags.length}} 项标签</text>
      </view>
      <text class="record-reflect" wx:if="{{item.reflect}}">{{item.reflect}}</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <view class="empty-icon">
      <view class="empty-circle"></view>
      <view class="empty-line"></view>
    </view>
    <text class="empty-text">暂无记录</text>
    <text class="empty-hint">去「今日打卡」写一条吧</text>
  </view>
</view>
