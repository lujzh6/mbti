/* pages/records/records.wxss - 记录列表 (族群色彩版) */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--space-page);
  padding-bottom: 160rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

/* 页面标题 */
.page-header {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-text);
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

/* 操作 */
.actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
}

/* 记录列表 */
.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-item {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx 28rpx;
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  /* 左侧彩色边框 */
  border-left: 6rpx solid var(--color-analysts);
}

/* 交替使用四种族群色 */
.record-item:nth-child(4n+1) { border-left-color: var(--color-analysts); }
.record-item:nth-child(4n+2) { border-left-color: var(--color-diplomats); }
.record-item:nth-child(4n+3) { border-left-color: var(--color-sentinels); }
.record-item:nth-child(4n+4) { border-left-color: var(--color-explorers); }

.record-top {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.record-date-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-date {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.scene-badge {
  background: var(--color-analysts-light);
  color: var(--color-analysts);
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
}

/* 心情条 - 渐变 */
.record-mood-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mood-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

.mood-bar-track {
  flex: 1;
  height: 8rpx;
  background: var(--color-separator);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.mood-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-analysts), var(--color-analysts-mid));
  border-radius: var(--radius-full);
  transition: width 0.3s ease;
}

/* 交替心情条颜色 */
.record-item:nth-child(4n+2) .mood-bar-fill {
  background: linear-gradient(90deg, var(--color-diplomats), var(--color-diplomats-mid));
}
.record-item:nth-child(4n+3) .mood-bar-fill {
  background: linear-gradient(90deg, var(--color-sentinels), var(--color-sentinels-mid));
}
.record-item:nth-child(4n+4) .mood-bar-fill {
  background: linear-gradient(90deg, var(--color-explorers), var(--color-explorers-mid));
}

.mood-score {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-analysts);
  min-width: 40rpx;
  text-align: right;
}

/* 标签 */
.record-tags {
  display: flex;
}

.tag-count {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  background: var(--color-bg-elevated);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
}

/* 反思 */
.record-reflect {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
  border-top: 1rpx solid var(--color-separator);
  padding-top: 12rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 100rpx 0;
}

.empty-icon {
  width: 100rpx;
  height: 100rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 空状态四色圆圈 */
.empty-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 4rpx solid var(--color-analysts-mid);
  position: absolute;
  top: 8rpx;
  left: 8rpx;
}

.empty-line {
  position: absolute;
  bottom: 16rpx;
  right: 12rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 4rpx solid var(--color-diplomats-mid);
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.empty-hint {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}
