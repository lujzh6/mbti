/* pages/records/records.wxss - 记录列表 */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--space-page);
  padding-bottom: 160rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

/* 页面标题 */
.page-header {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

/* 操作 */
.actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
}

/* 记录列表 */
.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-item {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx 28rpx;
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.record-top {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.record-date-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-date {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.scene-badge {
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
}

/* 心情条 */
.record-mood-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mood-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

.mood-bar-track {
  flex: 1;
  height: 8rpx;
  background: var(--color-separator);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.mood-bar-fill {
  height: 100%;
  background: var(--color-primary);
  border-radius: var(--radius-full);
  transition: width 0.3s ease;
}

.mood-score {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
  min-width: 40rpx;
  text-align: right;
}

/* 标签 */
.record-tags {
  display: flex;
}

.tag-count {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  background: var(--color-bg-elevated);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
}

/* 反思 */
.record-reflect {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
  padding-top: 4rpx;
  border-top: 1rpx solid var(--color-separator);
  margin-top: 4rpx;
  padding-top: 12rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 100rpx 0;
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid var(--color-border);
}

.empty-line {
  position: absolute;
  bottom: 8rpx;
  width: 32rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--color-border);
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.empty-hint {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}
